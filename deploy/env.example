# RidgeNote standalone deployment environment.
# Copy to `.env`, change the values you need, then: chmod 600 .env
# See detailed configuration explanations at https://github.com/Br0kenSilos/RidgeNote/blob/main/docs/CONFIGURATION.md

# === REQUIRED ===========================================================
RIDGENOTE_SECRET_KEY=replace-with-a-generated-secret-key
# You can use "openssl rand -hex 48" to generate an appropriate random string for this.

RIDGENOTE_DATABASE_PASSWORD=replace-with-a-generated-password
# You can use "openssl rand -hex 32" to generate an appropriate random string for this.

RIDGENOTE_ALLOWED_HOSTS=127.0.0.1,192.0.2.10,ridgenote.example.com
# Comma separated list of Names/IPs used to reach this RidgeNote server. Keep 127.0.0.1.



# === OPTIONAL / COMMON ==================================================
# ========= URL and REVERSE PROXY OPTIONS =================================
RIDGENOTE_EXTERNAL_URL=
# Full URL users access RidgeNote through. Used when RidgeNote generates links back to itself.

# Reverse proxy settings — only change these if RidgeNote is behind a reverse proxy.
RIDGENOTE_CSRF_TRUSTED_ORIGINS=
# e.g. https://ridgenote.example.com — Required when using a reverse proxy.

RIDGENOTE_TRUST_X_FORWARDED_PROTO=false
# Set true if your proxy sends X-Forwarded-Proto.

RIDGENOTE_USE_X_FORWARDED_HOST=false
# Usually leave false; enable only if your proxy relies on X-Forwarded-Host.


# ========= LOGGING & DEBUG =================================
# Logging / troubleshooting
RIDGENOTE_DEBUG=0
# Leave 0 for normal use. A value of 1 enables Django debug mode.
# WARNING: A value of 1 and enabling debug mode can expose detailed internal/error information. Use with caution.

RIDGENOTE_LOG_LEVEL=INFO
# Normal logging level. Change only for troubleshooting.


# ========= DATABASE =================================
# Database — safe defaults for normal deployments. You can use different names if you really want to.
RIDGENOTE_DATABASE_NAME=ridgenote
RIDGENOTE_DATABASE_USER=ridgenote
RIDGENOTE_DATABASE_PORT=5432

# ========= LOGIN SECURITY & SESSION HANDLING ==============
# Login / session security — safe defaults for normal use.
RIDGENOTE_LOGIN_LOCKOUT_THRESHOLD=5
RIDGENOTE_LOGIN_LOCKOUT_WINDOW_SECONDS=900
RIDGENOTE_LOGIN_LOCKOUT_DURATION_SECONDS=900
RIDGENOTE_SESSION_IDLE_TIMEOUT_SECONDS=3600
RIDGENOTE_SESSION_WARNING_SECONDS=300

# ========= TRASH HANDLING =================================
# Trash lifecycle
RIDGENOTE_PURGE_ENABLED=true
# Automatically purge items after the final retention window ends.

RIDGENOTE_PURGE_INTERVAL_SECONDS=86400
# Set the interval at which RidgeNote checks for trash items that can be purged. Not how long items stay in trash.
# 86400 equates to checking once per day.


# ========= EMAIL HANDLING =================================
# Invitations
RIDGENOTE_INVITATION_EXPIRY_MINUTES=120
# Default lifetime for newly issued invitation links, in minutes.

# SMTP / invitation email — leave these blank to use manual invitation links only. (no email functionality)
RIDGENOTE_SMTP_HOST=
# SMTP server, e.g. smtp.example.com

RIDGENOTE_SMTP_PORT=
# e.g. 465/587

RIDGENOTE_SMTP_TLS_MODE=
# none | starttls | ssl

RIDGENOTE_SMTP_USERNAME=

RIDGENOTE_SMTP_PASSWORD=

RIDGENOTE_SMTP_FROM_EMAIL=
# e.g. ridgenote@example.com

RIDGENOTE_SMTP_FROM_NAME=
# Optional display name, e.g. RidgeNote Administrator
