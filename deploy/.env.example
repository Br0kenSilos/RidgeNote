# RidgeNote standalone deployment environment.
# Copy to `.env`, fill in the values below, then: chmod 600 .env
# Never commit the real `.env` file.

# === REQUIRED ===========================================================
# You must deliberately set each of these for a normal deployment --
# none of them has a safe default.

# RidgeNote image to run. Use `latest` for convenience, or a fixed
# version/commit tag when you want deployments to remain pinned. See
# README, "Image tags".
RIDGENOTE_IMAGE=ghcr.io/br0kensilos/ridgenote:v1.0.0

# Generate with: openssl rand -hex 48
RIDGENOTE_SECRET_KEY=replace-with-a-generated-secret-key

# One database password, used by both RidgeNote and PostgreSQL --
# docker-compose.yml wires them together, so there is nothing else to
# set or match by hand. Generate with: openssl rand -hex 32
RIDGENOTE_DATABASE_PASSWORD=replace-with-a-generated-password

# The hostname(s)/IP(s) used to reach RidgeNote, comma-separated, no
# wildcard. Keep 127.0.0.1 -- the packaged health check always
# requests it from inside the container.
RIDGENOTE_ALLOWED_HOSTS=192.0.2.10,127.0.0.1

# === OPTIONAL ============================================================
# Every setting below has a safe, working default. Leave a section
# alone unless its own comment says your deployment needs it.

# -- Network / URL -------------------------------------------------------

# The externally-reached URL for this instance (scheme://host[:port],
# no path). Blank (the default) is valid for a direct-LAN deployment;
# it only becomes necessary once SMTP invitation delivery is
# configured below, since RidgeNote needs it to build the absolute
# link inside an automatically-sent invitation email. Ordinary
# browsing, login, and the manual one-time invitation Copy Link never
# use this value.
RIDGENOTE_EXTERNAL_URL=

# Only needed behind a reverse proxy serving RidgeNote over HTTPS on
# its own hostname; must then exactly match the externally reached
# origin(s). Not needed for this document's plain-HTTP, direct-LAN
# topology -- Django's CSRF check that consults this value only runs
# for HTTPS requests. See docs/RUNBOOK_DEPLOYMENT.md for reverse-proxy
# topology.
RIDGENOTE_CSRF_TRUSTED_ORIGINS=

# -- Reverse proxy ---------------------------------------------------------
# Both false by default; only relevant if you place a reverse proxy in
# front of RidgeNote. See docs/RUNBOOK_DEPLOYMENT.md for the full
# topology this pair covers.

# Only true behind a reverse proxy that sets X-Forwarded-Proto.
RIDGENOTE_TRUST_X_FORWARDED_PROTO=false

# Independent of RIDGENOTE_TRUST_X_FORWARDED_PROTO above -- only needed
# if your specific reverse-proxy contract relies on X-Forwarded-Host
# rather than forwarding the real Host header unchanged (most
# single-hostname, root-path reverse proxies do not need this).
RIDGENOTE_USE_X_FORWARDED_HOST=false

# -- Application defaults --------------------------------------------------

# Never set true in a real deployment -- enables Django's debug error
# pages, which can leak internal detail. Startup fails loudly if this
# is false and RIDGENOTE_SECRET_KEY above is still unset.
RIDGENOTE_DEBUG=0

# -- Database defaults ------------------------------------------------------
# Safe as shipped. PostgreSQL's own internal database/user/password are
# derived automatically from these three RidgeNote-facing settings --
# there is nothing else to set or keep in sync by hand.
RIDGENOTE_DATABASE_NAME=ridgenote
RIDGENOTE_DATABASE_USER=ridgenote
RIDGENOTE_DATABASE_PORT=5432

# -- Logging ----------------------------------------------------------------

RIDGENOTE_LOG_LEVEL=INFO

# -- Login/session security -------------------------------------------------
# Safe as shipped for ordinary household/small-team use.

RIDGENOTE_LOGIN_LOCKOUT_THRESHOLD=5
RIDGENOTE_LOGIN_LOCKOUT_WINDOW_SECONDS=900
RIDGENOTE_LOGIN_LOCKOUT_DURATION_SECONDS=900
RIDGENOTE_SESSION_IDLE_TIMEOUT_SECONDS=3600
RIDGENOTE_SESSION_WARNING_SECONDS=300

# -- Invitations --------------------------------------------------------

# How long an administrator-issued invitation link stays valid, in
# minutes, before it must be reissued.
RIDGENOTE_INVITATION_EXPIRY_MINUTES=120

# -- Trash scheduler ------------------------------------------------------

# Automatic Trash purge -- leave disabled unless intended. When false,
# the scheduler container starts, logs that it is idle, and does
# nothing else.
RIDGENOTE_PURGE_ENABLED=false
# How often the scheduler checks for eligible Trash items, in seconds,
# when purge is enabled above. Ignored while disabled.
RIDGENOTE_PURGE_INTERVAL_SECONDS=86400

# -- SMTP invitation delivery -----------------------------------------------
# Every variable below is OPTIONAL. Leave them all blank (the default) to
# keep RidgeNote's existing manual-copy invitation workflow -- nothing
# degrades, nothing warns, and no automatic-send control is even shown.
# Automatic email becomes available only once RIDGENOTE_SMTP_HOST,
# RIDGENOTE_SMTP_PORT, RIDGENOTE_SMTP_FROM_EMAIL, and RIDGENOTE_EXTERNAL_URL
# (above) are ALL set.

# RIDGENOTE_SMTP_HOST: e.g. smtp.example.com
RIDGENOTE_SMTP_HOST=
# RIDGENOTE_SMTP_PORT: a positive integer, e.g. 587 (STARTTLS), 465 (SSL),
# or 25/2525 for an internal unencrypted relay. Never inferred from the
# TLS mode below -- set explicitly.
RIDGENOTE_SMTP_PORT=
# RIDGENOTE_SMTP_TLS_MODE: one of none | starttls | ssl. Blank defaults to
# none. Any other value fails clearly at startup.
RIDGENOTE_SMTP_TLS_MODE=
# RIDGENOTE_SMTP_USERNAME / RIDGENOTE_SMTP_PASSWORD: leave BOTH blank for
# an unauthenticated internal relay that permits it. Otherwise set BOTH --
# setting only one is rejected at startup as likely-accidental
# half-configuration.
RIDGENOTE_SMTP_USERNAME=
# SECRET -- never commit a real value here. Populate only in your local,
# gitignored .env file.
RIDGENOTE_SMTP_PASSWORD=
# RIDGENOTE_SMTP_FROM_EMAIL: required once any other SMTP variable above
# is set, e.g. ridgenote@example.com
RIDGENOTE_SMTP_FROM_EMAIL=
# RIDGENOTE_SMTP_FROM_NAME: optional display name, e.g. RidgeNote --
# produces "RidgeNote <ridgenote@example.com>". Leave blank to use the
# bare From address alone.
RIDGENOTE_SMTP_FROM_NAME=
