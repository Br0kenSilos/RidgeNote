    "eslint": "9.39.1",
    "jsdom": "^25.0.1",
    "prettier": "3.7.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0",
    "vite": "7.3.6",
    "vitest": "4.1.9"
